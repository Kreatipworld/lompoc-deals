# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers brainstorming mockups
.superpowers/

# Scraped contact exports (not for version control)
exports/
scripts/mirror-backup-*.json
.claude/worktrees/

# outreach send/suppression logs (contain contact emails)
scripts/data/

# Generated social media (reproducible from scripts + DB; published copies live on Vercel Blob).
# Every regeneration rewrites every card, and git keeps each version forever — tracking them
# put .git at 514 MB. The deck HTML, calendar.csv and the ledger are the reviewable artefacts.
content/social/posts/*.png
content/social/video/*.mp4
content/social/video/masters/*.mp4
content/social/launch-kit/**/*.png

# Same rule as above, for the directories added since: ad deliverables are derived from the
# source cut by build-ad-masters.mjs, and the narration/generated stills are large binaries that
# git would keep a copy of on every regeneration. The durable archive for all of this is Dropbox
# — run scripts/sync-content-to-dropbox.sh, which mirrors it and never deletes.
content/social/video/ad-masters/
content/social/video/vo/
content/social/assets/generated-people/

# heavy media stays local + CDN — never in git
docs/marketing/taco-route/*.mp4
docs/marketing/taco-route/*.wav

# news-kit rendered cards + news-desk video project generated artifacts
content/social/news-kit/*.png
content/social/video/news-desk/renders/
content/social/video/news-desk/snapshots*/
content/social/video/news-desk/node_modules/
content/social/video/news-desk/.hyperframes/

# Higgsfield OAuth token (scripts/higgsfield-mcp)
hf-token.json
hf-mcp-session.txt

# HyperFrames flyover keyframe cache (regenerable)
**/.flycache/
content/social/video/*/renders/
content/social/video/*/node_modules/
